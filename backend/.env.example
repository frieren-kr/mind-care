# ==== Database (PostgreSQL + pgvector) ====
# docker-compose.yml이 참조하는 값. 각자 원하는 비밀번호로 채운다 (커밋 금지).
# DATABASE_URL의 비밀번호도 같은 값으로 맞춰야 한다.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mindcare:PASSWORD_HERE@localhost:5432/mindcare

# ==== PubMed (NCBI E-utilities) ====
# 발급: https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_API_KEY=
PUBMED_EMAIL=parkjoohyun12345@gmail.com

# ==== LLM / Embedding API ====
# 아래 중 사용하는 것만 채우면 됩니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ==== Celery / 배치 (주 1회 논문 수집) ====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==== App ====
APP_ENV=development
