# ==== Database (PostgreSQL + pgvector) ====
# docker-compose.yml이 참조하는 값. 각자 원하는 비밀번호로 채운다 (커밋 금지).
# DATABASE_URL의 비밀번호도 같은 값으로 맞춰야 한다.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mindcare:PASSWORD_HERE@localhost:5432/mindcare

# ==== PubMed (NCBI E-utilities) ====
# API 키 발급(선택): https://www.ncbi.nlm.nih.gov/account/settings/
#   - 키가 없어도 동작한다 (초당 3회 제한, 키가 있으면 초당 10회).
# PUBMED_EMAIL: NCBI 권장 항목. 요청에 문제가 생겼을 때 NCBI가 연락하는 주소라
#   ★ 각자 본인 메일 주소를 넣는다 ★ (팀 공용 주소나 남의 주소를 쓰지 않는다).
PUBMED_API_KEY=
PUBMED_EMAIL=

# ==== LLM / Embedding API ====
# 아래 중 사용하는 것만 채우면 됩니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ==== Celery / 배치 (주 1회 논문 수집) ====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==== App ====
APP_ENV=development
