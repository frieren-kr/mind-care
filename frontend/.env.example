# Expo는 EXPO_PUBLIC_ 접두사만 클라이언트에 노출한다. 이 파일을 .env.local로 복사해서 값을 채운다 (.env.local은 git에 올라가지 않는다).
# 값을 바꾸면 `npx expo start -c`로 다시 실행해야 반영된다.

# 백엔드 주소. 비우면 안드로이드 에뮬레이터는 http://10.0.2.2:8000, 웹·iOS 시뮬레이터는 http://localhost:8000
# 실기기는 PC IP를 넣고, 백엔드를 `uvicorn main:app --reload --host 0.0.0.0`으로 띄운다.
EXPO_PUBLIC_API_BASE_URL=

# 로그인 기능 전까지 쓸 간병인 id (users.id). backend/에서 `python -m scripts.list_users`로 확인
EXPO_PUBLIC_DEV_USER_ID=
